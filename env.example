# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to the browser

# Razorpay (Dashboard -> Settings -> API Keys / Subscriptions -> Plans / Settings -> Webhooks)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
